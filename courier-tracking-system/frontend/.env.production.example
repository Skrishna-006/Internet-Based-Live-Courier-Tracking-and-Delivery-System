# ============================================================
# Frontend Production Environment Variables — EXAMPLE FILE
# Copy to .env.production.local and fill in real values.
# This file is safe to commit. Never commit .env.production.local.
# ============================================================

# Backend API base URL (must include /api/v1)
# When frontend and backend are on the same host, leave blank to use relative /api/v1
# When hosted separately (e.g. frontend on Vercel, backend on Render):
VITE_API_BASE_URL=https://your-backend-host.com/api/v1

# WebSocket broker URL
# Use wss:// for HTTPS hosts, ws:// for HTTP
VITE_WS_URL=wss://your-backend-host.com/ws
